
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductType {
  PREBUILT_KIT
  FERTILIZER
  CUSTOM_KIT
  ACCESSORY
}

enum ComponentType {
  SEED
  FERTILIZER
  SUBSTRATE
  POT
  TOOL
  GUIDE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  COMPLETED
  CANCELLED
}

enum OrderItemType {
  PRODUCT
  PREBUILT_KIT
  CUSTOM_KIT
}


model Category {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  description String?
  price       Decimal     @db.Decimal(12, 2)
  stock       Int         @default(0)
  imageUrl    String?
  isActive    Boolean     @default(true)
  type        ProductType

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([type, isActive])
}

model ProductVariant {
  id          String  @id @default(uuid())
  productId   String
  name        String
  slug        String
  description String?
  price       Decimal @db.Decimal(12, 2)
  stock       Int     @default(0)
  imageUrl    String?
  isActive    Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  recipeItems KitRecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, slug])
  @@index([productId, isActive])
}

model KitComponent {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  type        ComponentType
  price       Decimal       @db.Decimal(12, 2)
  stock       Int           @default(0)
  isActive    Boolean       @default(true)

  recipeItems KitRecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
}

model KitRecipeItem {
  id          String @id @default(uuid())
  variantId   String
  componentId String
  quantity    Int    @default(1)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  component KitComponent @relation(fields: [componentId], references: [id])

  @@unique([variantId, componentId])
  @@index([componentId])
}

model PreferenceResponse {
  id             String @id @default(uuid())
  experience     String
  availableSpace String
  cropInterest   String
  kitPreference  String?
  municipality   String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Order {
  id String @id @default(uuid())

  // Información del cliente.
  customerName  String
  customerPhone String
  municipality  String
  deliveryAddress String
  notes         String?

  // Información económica.
  subtotal Decimal @db.Decimal(12, 2)

  // Estado inicial del pedido.
  status OrderStatus @default(PENDING)

  // Productos y kits del pedido.
  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String

  // Identificadores históricos del catálogo.
  // No se crean relaciones obligatorias porque
  // el producto podría cambiar posteriormente.
  productId String?
  variantId String?

  // Información conservada al registrar el pedido.
  type        OrderItemType
  name        String
  variantName String?
  quantity    Int

  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  components OrderItemComponent[]

  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderItemComponent {
  id          String @id @default(uuid())
  orderItemId String

  // Referencia histórica del componente.
  componentId String?

  name      String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

