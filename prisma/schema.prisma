generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMERACIONES
// ============================================

enum ProductType {
  PREBUILT_KIT
  FERTILIZER
  CUSTOM_KIT
  ACCESSORY
}

enum ComponentType {
  SEED
  FERTILIZER
  SUBSTRATE
  POT
  TOOL
  GUIDE
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
}

enum OrderItemType {
  PRODUCT
  PREBUILT_KIT
  CUSTOM_KIT
}

// ============================================
// CATEGORÍAS
// ============================================

model Category {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// PRODUCTOS DEL CATÁLOGO
// ============================================

model Product {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  description String?
  price       Decimal     @db.Decimal(12, 2)
  stock       Int         @default(0)
  imageUrl    String?
  isActive    Boolean     @default(true)
  isArchived  Boolean     @default(false)
  type        ProductType

  categoryId String

  category Category @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([type, isActive])
}

// ============================================
// VARIANTES DE PRODUCTOS
// ============================================

model ProductVariant {
  id          String  @id @default(uuid())
  productId   String
  name        String
  slug        String
  description String?
  price       Decimal @db.Decimal(12, 2)
  stock       Int     @default(0)
  imageUrl    String?
  isActive    Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  recipeItems KitRecipeItem[]

  kitComponent KitComponent?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, slug])
  @@index([productId, isActive])
}

// ============================================
// COMPONENTES PARA ARMAR KITS
// ============================================

model KitComponent {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  type        ComponentType
  price       Decimal       @db.Decimal(12, 2)
  stock       Int           @default(0)
  isActive    Boolean       @default(true)

  // NUEVO:
  // Relación opcional con una variante comercial.
  //
  // Si productVariantId tiene un valor:
  // el inventario oficial es ProductVariant.stock.
  //
  // Si productVariantId es null:
  // el inventario oficial es KitComponent.stock.
  productVariantId String? @unique

  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  recipeItems KitRecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
}

// ============================================
// RECETAS DE KITS PREDISEÑADOS
// ============================================

model KitRecipeItem {
  id          String @id @default(uuid())
  variantId   String
  componentId String
  quantity    Int    @default(1)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  component KitComponent @relation(fields: [componentId], references: [id])

  @@unique([variantId, componentId])
  @@index([componentId])
}

// ============================================
// RESPUESTAS DE PREFERENCIAS
// ============================================

model PreferenceResponse {
  id             String  @id @default(uuid())
  experience     String
  availableSpace String
  cropInterest   String
  kitPreference  String?
  municipality   String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ============================================
// PEDIDOS
// ============================================

model Order {
  id String @id @default(uuid())

  // Evita la creación duplicada de pedidos.
  idempotencyKey String? @unique
  requestHash    String?

  // Información del cliente.
  customerName    String
  customerPhone   String
  municipality    String
  deliveryAddress String
  notes           String?

  // Información económica.
  subtotal Decimal @db.Decimal(12, 2)

  // Ciclo de vida del pedido.
  status OrderStatus @default(PENDING)

  // Fecha de verificación del pago.
  paidAt DateTime?

  // Fecha de entrega.
  completedAt DateTime?

  // Fecha de cancelación.
  cancelledAt DateTime?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ============================================
// ARTÍCULOS DE PEDIDOS
// ============================================

model OrderItem {
  id      String @id @default(uuid())
  orderId String

  // Referencias históricas al catálogo.
  // No son relaciones obligatorias.
  productId String?
  variantId String?

  type        OrderItemType
  name        String
  variantName String?
  quantity    Int

  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  components OrderItemComponent[]

  createdAt DateTime @default(now())

  @@index([orderId])
}

// ============================================
// COMPONENTES HISTÓRICOS DE PEDIDOS
// ============================================

model OrderItemComponent {
  id          String @id @default(uuid())
  orderItemId String

  // Referencia histórica al componente.
  componentId String?

  name      String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

// ============================================
// ADMINISTRADORES
// ============================================

model AdminUser {
  id           String  @id @default(uuid())
  email        String  @unique
  name         String
  passwordHash String
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}
